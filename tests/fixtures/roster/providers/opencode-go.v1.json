  "negative_cases": [
    {
      "case_id": "route-token-shape-generic-api-key",
      "description": "An API-key-shaped plan token is not generic API-key permission.",
      "mutations": [
        "auth_class=api-key",
        "entitlement_proof.auth_class=api-key",
        "billing_route_proof.auth_class=api-key"
      ],
      "expected_issue_codes": [
        "OPENCODE_GO_GENERIC_API_KEY_FORBIDDEN",
        "OPENCODE_GO_PLAN_TOKEN_PROOF_REQUIRED",
        "OPENCODE_GO_ROUTE_TOKEN_SHAPE_IS_NOT_API_KEY_PERMISSION"
      ]
    },
    {
      "case_id": "wrong-api",
      "description": "OpenCode Go frozen role requests use openai-completions only.",
      "role": "parent",
      "mutations": [
        "role.request_profile.api=anthropic-messages",
        "role.observed_profile.api=anthropic-messages"
      ],
      "expected_issue_codes": [
        "OPENCODE_GO_OBSERVED_PROFILE_MISMATCH",
        "OPENCODE_GO_REQUEST_PROFILE_MISMATCH"
      ]
    },
    {
      "case_id": "wrong-model",
      "description": "Frozen Kimi K2.7 Code implement role cannot execute a different model.",
      "role": "implement",
      "mutations": [
        "role.request_profile.model_id=kimi-k3",
        "role.observed_profile.executed_model_id=kimi-k3"
      ],
      "expected_issue_codes": [
        "OPENCODE_GO_OBSERVED_PROFILE_MISMATCH",
        "OPENCODE_GO_REQUEST_PROFILE_MISMATCH"
      ]
    },
    {
      "case_id": "wrong-thinking",
      "description": "Frozen xhigh/high thinking values are exact and never clamped.",
      "role": "parent",
      "mutations": [
        "role.request_profile.thinking=high",
        "role.observed_profile.thinking=high"
      ],
      "expected_issue_codes": [
        "OPENCODE_GO_OBSERVED_PROFILE_MISMATCH",
        "OPENCODE_GO_REQUEST_PROFILE_MISMATCH"
      ]
    },
    {
      "case_id": "wrong-context",
      "description": "Context window compatibility is exact for request profiles.",
      "role": "extract",
      "mutations": [
        "role.request_profile.context_window=256000"
      ],
      "expected_issue_codes": [
        "OPENCODE_GO_REQUEST_PROFILE_MISMATCH"
      ]
    },
    {
      "case_id": "wrong-tool",
      "description": "Tool-use support is part of the exact request profile.",
      "role": "fix",
      "mutations": [
        "role.request_profile.tool_capability=tool-use-unsupported"
      ],
      "expected_issue_codes": [
        "OPENCODE_GO_REQUEST_PROFILE_MISMATCH"
      ]
    },
    {
      "case_id": "mixed-route",
      "description": "No Kimi Coding/OpenRouter/arbitrary-key route can be mixed into OpenCode Go.",
      "role": "bughunt",
      "mutations": [
        "role.provider_id=kimi-coding",
        "role.route_policy_id=kimi-coding-plan-v1",
        "role.request_profile.provider_id=kimi-coding",
        "role.observed_profile.provider_id=kimi-coding"
      ],
      "expected_issue_codes": [
        "OPENCODE_GO_MIXED_ROUTE_FORBIDDEN",
        "OPENCODE_GO_OBSERVED_PROFILE_MISMATCH",
        "OPENCODE_GO_PROVIDER_ID_MISMATCH",
        "OPENCODE_GO_REQUEST_PROFILE_MISMATCH",
        "OPENCODE_GO_ROUTE_POLICY_MISMATCH"
      ]
    }
  ]
