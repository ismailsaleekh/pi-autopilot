{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": "..",
    "paths": {
      "@earendil-works/pi-coding-agent": ["src/pi-coding-agent-shim.d.ts"]
    },
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "skipLibCheck": false,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "../child-runtime/**/*.ts"]
}

