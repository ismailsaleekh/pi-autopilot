{
  "name": "pi-autopilot",
  "version": "1.3.1",
  "description": "Standalone Autopilot Host backed by the Rust autopilot-core binary.",
  "type": "module",
  "license": "ISC",
  "author": "Ismail Salikhodjaev <ismailsalikhodjaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailsaleekh/pi-autopilot.git"
  },
  "bugs": {
    "url": "https://github.com/ismailsaleekh/pi-autopilot/issues"
  },
  "homepage": "https://github.com/ismailsaleekh/pi-autopilot#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "autopilot",
    "orchestration"
  ],
  "files": [
    "src/",
    "!src/resolve-core-runtime.d.ts",
    "child-runtime/",
    "extensions/",
    "bin/",
    "binaries/",
    "docs/generated/",
    "AUTOPILOT-INSTRUCTIONS.md",
    "logo.png",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "autopilot-core": "bin/autopilot-core.mjs",
    "autopilot-agent-run": "bin/autopilot-agent-run.mjs"
  },
  "scripts": {
    "build": "cargo build --release --workspace",
    "typecheck": "tsc --noEmit -p host/tsconfig.json",
    "test:rust": "cargo test -q",
    "test:host": "node --experimental-strip-types --test host/tests/*.test.ts",
    "test:tree-ts": "node scripts/run-tests-tree.mjs",
    "test:packed-consumer": "node scripts/test-packed-consumer.mjs",
    "test:runtime-integration": "node --experimental-strip-types --test host/integration-tests/four-path-background-runtime.test.ts",
    "test": "npm run typecheck && npm run gate:real-producers && npm run gate:binary-parity && npm run test:rust && npm run test:host && npm run test:tree-ts",
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:verify": "node scripts/docs-verify.mjs",
    "payload:check": "node scripts/check-payload.mjs",
    "gate:selftest": "./scripts/gates/selftest.sh",
    "gate:loc:core": "./scripts/gates/loc.sh core",
    "gate:loc:tooling": "./scripts/gates/loc.sh tooling",
    "gate:kernel-purity": "./scripts/gates/kernel-purity.sh",
    "gate:no-inference": "./scripts/gates/no-inference.sh",
    "gate:host-thinness": "./scripts/gates/host-thinness.sh",
    "gate:child-runtime-thinness": "./scripts/gates/child-runtime-thinness.sh",
    "gate:binary-parity": "./scripts/gates/binary-parity.sh",
    "gate:launch-entrypoint": "node scripts/check-launch-entrypoint.mjs",
    "gate:real-producers": "node scripts/gates/real-producers.mjs",
    "gate:readable-source": "node scripts/gates/readable-source.mjs",
    "gate:readable-source:selftest": "node scripts/gates/readable-source-selftest.mjs",
    "gate:release": "npm run codegen:check && npm run modelcheck && npm run gate:readable-source && npm run gate:loc:core && npm run gate:loc:tooling && npm run gate:kernel-purity && npm run gate:no-inference && npm run gate:host-thinness && npm run gate:child-runtime-thinness && npm run gate:real-producers && npm run gate:binary-parity && npm run gate:launch-entrypoint",
    "codegen:check": "cargo run -p codegen -- --check",
    "modelcheck": "cargo run -p modelcheck",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --audit-level=high",
    "sbom": "node scripts/generate-sbom.mjs",
    "prepack": "npm run build && npm run typecheck && npm run gate:release && npm run security:scan -- --quiet && npm run sbom",
    "pack:dry-run": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/autopilot.ts"
    ],
    "image": "https://raw.githubusercontent.com/ismailsaleekh/pi-autopilot/main/logo.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
