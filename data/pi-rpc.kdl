schema "autopilot.pi-rpc.v1"
version 1
command "prompt" serde="prompt" variant="Prompt" constructor="prompt" payload="message:String" request_id=#true begins_cycle=#true
command "steer" serde="steer" variant="Steer" constructor="steer" payload="message:String" request_id=#true queued_not_delivered=#true
command "compact" serde="compact" variant="Compact" constructor="compact" payload="custom_instructions:String:customInstructions" request_id=#true manual_compaction=#true
command "set_auto_compaction" serde="set_auto_compaction" variant="SetAutoCompaction" constructor="set_auto_compaction" payload="enabled:bool" request_id=#true
command "get_state" serde="get_state" variant="GetState" constructor="get_state" payload="" request_id=#true
command "get_session_stats" serde="get_session_stats" variant="GetSessionStats" constructor="get_session_stats" payload="" request_id=#true
command "get_entries" serde="get_entries" variant="GetEntries" constructor="get_entries" payload="" request_id=#true bootstrap_only=#true
command "abort" serde="abort" variant="Abort" constructor="abort" payload="" request_id=#true
wire_enum "RpcCommandKind" serde_tag="type"
wire_variant "RpcCommandKind:prompt" enum="RpcCommandKind" variant="Prompt" serde="prompt"
wire_variant "RpcCommandKind:steer" enum="RpcCommandKind" variant="Steer" serde="steer"
wire_variant "RpcCommandKind:compact" enum="RpcCommandKind" variant="Compact" serde="compact"
wire_variant "RpcCommandKind:set_auto_compaction" enum="RpcCommandKind" variant="SetAutoCompaction" serde="set_auto_compaction"
wire_variant "RpcCommandKind:get_state" enum="RpcCommandKind" variant="GetState" serde="get_state"
wire_variant "RpcCommandKind:get_session_stats" enum="RpcCommandKind" variant="GetSessionStats" serde="get_session_stats"
wire_variant "RpcCommandKind:get_entries" enum="RpcCommandKind" variant="GetEntries" serde="get_entries"
wire_variant "RpcCommandKind:abort" enum="RpcCommandKind" variant="Abort" serde="abort"
wire_enum "CompactionReason" serde_tag=""
wire_variant "CompactionReason:manual" enum="CompactionReason" variant="Manual" serde="manual"
wire_variant "CompactionReason:threshold" enum="CompactionReason" variant="Threshold" serde="threshold"
wire_variant "CompactionReason:overflow" enum="CompactionReason" variant="Overflow" serde="overflow"
wire_enum "CustomEntryKind" serde_tag="type"
wire_variant "CustomEntryKind:custom" enum="CustomEntryKind" variant="Custom" serde="custom"
wire_enum "MessageContent" serde_tag="type"
wire_variant "MessageContent:text" enum="MessageContent" variant="Text" serde="text"
wire_variant "MessageContent:other" enum="MessageContent" variant="Other" serde="other"
wire_record "FrameEnvelope" fields="type:kind:String:required"
wire_record "ResponseRecord" fields="id:id:String:optional|command:command:String:required|success:success:bool:required|data:data:Value:optional|error:error:String:optional"
wire_record "AgentEnd" fields="willRetry:will_retry:bool:required"
wire_record "MessageEnd" fields="message:message:AgentMessage:required"
wire_record "AgentMessage" fields="role:role:String:required|toolCallId:tool_call_id:String:optional|toolName:tool_name:String:optional|provider:provider:String:optional|model:model:String:optional|stopReason:stop_reason:String:optional|content:content:Vec<MessageContent>:optional|errorMessage:error_message:String:optional|details:details:Value:optional"
wire_record "MessageContentText" fields="text:text:String:required"
wire_record "ToolExecutionEnd" fields="toolCallId:tool_call_id:String:required|toolName:tool_name:String:required|result:result:ToolExecutionResult:required|isError:is_error:bool:required"
wire_record "ToolExecutionResult" fields="details:details:Value:default_optional|terminate:terminate:bool:default"
wire_record "EntryAppendedRecord" fields="entry:entry:CustomSessionEntry:required"
wire_record "CustomSessionEntry" fields="type:_kind:CustomEntryKind:required|id:id:String:required|customType:custom_type:String:required|data:data:Value:required"
wire_record "QueueUpdate" fields="steering:steering:Vec<String>:default|followUp:follow_up:Vec<String>:default"
wire_record "CompactionStart" fields="reason:reason:CompactionReason:required"
wire_record "CompactionEnd" fields="reason:reason:CompactionReason:required|aborted:aborted:bool:default|willRetry:will_retry:bool:default"
wire_record "AutoRetryEnd" fields="success:success:bool:required"
event "agent_start" variant="AgentStart" record="" order="agent_start"
event "agent_end" variant="AgentEnd" record="AgentEnd" order="agent_end"
event "agent_settled" variant="AgentSettled" record="" order="agent_settled"
event "turn_start" variant="TurnStart" record="" order="running_progress"
event "turn_end" variant="TurnEnd" record="" order="running_progress"
event "message_start" variant="MessageStart" record="" order="running_progress"
event "message_end" variant="MessageEnd" record="MessageEnd" order="running_progress" terminal_bytes=#true
event "message_update" variant="MessageUpdateDiscarded" record="" order="running_progress" discard_counter="message_update_frames"
event "bash_execution_update" variant="BashExecutionUpdateDiscarded" record="" order="running_progress" discard_counter="bash_update_frames"
event "tool_execution_start" variant="ToolExecutionStart" record="" order="running_progress"
event "tool_execution_update" variant="ToolExecutionUpdateDiscarded" record="" order="running_progress" discard_counter="tool_update_frames"
event "tool_execution_end" variant="ToolExecutionEnd" record="ToolExecutionEnd" order="running_progress" terminal_bytes=#true
event "entry_appended" variant="EntryAppended" record="EntryAppendedRecord" order="idle_chatter" bootstrap_only=#true terminal_limit="entry_appended"
event "queue_update" variant="QueueUpdate" record="QueueUpdate" order="queue_update"
event "compaction_start" variant="CompactionStart" record="CompactionStart" order="compaction_start"
event "compaction_end" variant="CompactionEnd" record="CompactionEnd" order="compaction_end"
event "auto_retry_start" variant="AutoRetryStart" record="" order="retry_progress"
event "auto_retry_end" variant="AutoRetryEnd" record="AutoRetryEnd" order="retry_progress"
event "summarization_retry_scheduled" variant="SummarizationRetryScheduled" record="" order="retry_progress"
event "summarization_retry_attempt_start" variant="SummarizationRetryAttemptStart" record="" order="retry_progress"
event "summarization_retry_finished" variant="SummarizationRetryFinished" record="" order="retry_progress"
event "extension_error" variant="ExtensionError" record="" order="idle_chatter"
event "extension_ui_request" variant="ExtensionUiRequest" record="" order="idle_chatter"
launch_flag "mode" order=10 kind="value" name="--mode" value="rpc" identity_token="--mode=<RpcMode>" source="literal"
launch_flag "session-id" order=20 kind="value" name="--session-id" value="session_id" identity_token="--session-id=<SessionId>" source="config"
launch_flag "session-dir" order=30 kind="value" name="--session-dir" value="session_dir" identity_token="--session-dir=<SessionDir>" source="config"
launch_flag "no-extensions" order=40 kind="bare" name="--no-extensions" identity_token="--no-extensions" source="literal"
launch_flag "addon" order=50 kind="optional-addon" name="-e" value="runtime_addon" identity_token="-e=<RuntimeAddon>" source="config"
launch_flag "no-skills" order=60 kind="bare" name="--no-skills" identity_token="--no-skills" source="literal"
launch_flag "no-prompt-templates" order=70 kind="bare" name="--no-prompt-templates" identity_token="--no-prompt-templates" source="literal"
launch_flag "no-themes" order=80 kind="bare" name="--no-themes" identity_token="--no-themes" source="literal"
launch_flag "no-context-files" order=90 kind="bare" name="--no-context-files" identity_token="--no-context-files" source="literal"
launch_flag "provider" order=100 kind="value" name="--provider" value="provider" identity_token="--provider=<Provider>" source="config"
launch_flag "model" order=110 kind="value" name="--model" value="model" identity_token="--model=<Model>" source="config"
launch_flag "thinking" order=120 kind="value" name="--thinking" value="thinking" identity_token="--thinking=<Thinking>" source="config"
launch_flag "tools" order=130 kind="value" name="--tools" value="tools_csv" identity_token="--tools=<Tools>" source="config"
env_deny "OPENROUTER_API_KEY"
env_deny "OPENROUTER_BASE_URL"
env_deny "OPENAI_API_KEY"
env_deny "OPENAI_BASE_URL"
env_deny "ANTHROPIC_API_KEY"
env_deny "ANTHROPIC_BASE_URL"
env_deny "PI_API_KEY"
size_limit "terminal" bytes=4194304
size_limit "entry_appended" bytes=16384
state "idle" terminal_ok=#true
state "running"
state "after_end_no_retry"
state "after_end_retry"
state "after_end_retry_progress"
state "compacting_idle"
state "compacting_running"
state "compacting_after_end"
state "settled" terminal_ok=#true
order_event "agent_start"
order_event "agent_end"
order_event "queue_update"
order_event "compaction_start"
order_event "manual_compaction_start"
order_event "idle_chatter"
order_event "running_progress"
order_event "retry_progress"
order_event "agent_end_retry_false"
order_event "agent_end_retry_true"
order_event "agent_settled"
order_event "post_end_chatter"
order_event "compaction_end"
order_event "compaction_end_retry_false"
order_event "compaction_end_retry_true"
order_event "threshold_or_overflow_compaction_start"
transition "idle:agent_start" from="idle" event="agent_start" to="running"
transition "idle:manual_compaction_start" from="idle" event="manual_compaction_start" to="compacting_idle"
transition "idle:idle_chatter" from="idle" event="idle_chatter" to="idle"
transition "running:running_progress" from="running" event="running_progress" to="running"
transition "running:retry_progress" from="running" event="retry_progress" to="running"
transition "running:manual_compaction_start" from="running" event="manual_compaction_start" to="compacting_running"
transition "running:agent_end_retry_false" from="running" event="agent_end_retry_false" to="after_end_no_retry"
transition "running:agent_end_retry_true" from="running" event="agent_end_retry_true" to="after_end_retry"
transition "after_end_no_retry:agent_settled" from="after_end_no_retry" event="agent_settled" to="settled"
transition "after_end_no_retry:post_end_chatter" from="after_end_no_retry" event="post_end_chatter" to="after_end_no_retry"
transition "after_end_retry:post_end_chatter" from="after_end_retry" event="post_end_chatter" to="after_end_retry"
transition "after_end_retry:retry_progress" from="after_end_retry" event="retry_progress" to="after_end_retry_progress"
transition "after_end_retry_progress:retry_progress" from="after_end_retry_progress" event="retry_progress" to="after_end_retry_progress"
transition "after_end_retry_progress:agent_start" from="after_end_retry_progress" event="agent_start" to="running"
transition "after_end_no_retry:manual_compaction_start" from="after_end_no_retry" event="manual_compaction_start" to="compacting_after_end"
transition "after_end_retry:manual_compaction_start" from="after_end_retry" event="manual_compaction_start" to="compacting_after_end"
transition "after_end_retry_progress:manual_compaction_start" from="after_end_retry_progress" event="manual_compaction_start" to="compacting_after_end"
transition "compacting_idle:compaction_end" from="compacting_idle" event="compaction_end" to="idle"
transition "compacting_running:compaction_end" from="compacting_running" event="compaction_end" to="running"
transition "compacting_after_end:compaction_end_retry_false" from="compacting_after_end" event="compaction_end_retry_false" to="after_end_no_retry"
transition "compacting_after_end:compaction_end_retry_true" from="compacting_after_end" event="compaction_end_retry_true" to="after_end_retry_progress"
transition "compacting_idle:retry_progress" from="compacting_idle" event="retry_progress" to="compacting_idle"
transition "compacting_running:retry_progress" from="compacting_running" event="retry_progress" to="compacting_running"
transition "compacting_after_end:retry_progress" from="compacting_after_end" event="retry_progress" to="compacting_after_end"
forbidden "auto-compaction" event="threshold_or_overflow_compaction_start" reason="auto-compaction-disabled"
forbidden "post-settled" from="settled" event="*" reason="terminal-state"
