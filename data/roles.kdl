// package-owned role registry; generated output is derived from this file, not edited manually
role "onboard" {
  schema "autopilot.role.v1"
  version 1
  modes "thin-intake"
  model_slot "reasoning"
  thinking "xhigh"
  tools "read" "autopilot_submit_onboard"
  repository "bounded read-only"
  git "read-only"
  network "denied"
  package_state "denied"
  operator_checkout "denied"
  context_policy "onboard.v1"
  result_contract "onboard.v1"
  checkpoint_contract "agent-checkpoint.v1"
  terminal_path "autopilot_submit_onboard"
}
