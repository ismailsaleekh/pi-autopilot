// declarative driver tables moved out of Rust for D79 S2 headroom

table "prompt.base-sections" {
  values "Role and objective" "Authority and required read order" "Responsibilities" "Operating procedure" "Quality and evidence requirements" "Prohibited actions and non-goals" "Context gaps and checkpoint behavior" "Terminal result"
}

table "prompt.mode-sections" {
  values "Mode objective" "Additional context" "Mode procedure" "Mode evidence"
}

table "planning.d72-question-classes" {
  values "invalidated-decision" "missing-material-decision" "material-underdetermination" "dod-hole" "unsafe-irreversible"
}

table "planning.mode-parameter-atom-kind" {
  row parameter="WORK" planning_atom_kind="work"
  row parameter="DECISION" planning_atom_kind="decision"
  row parameter="CONSTRAINT" planning_atom_kind="constraint"
  row parameter="ACCEPTANCE" planning_atom_kind="acceptance"
  row parameter="PREMISE" planning_atom_kind="premise"
  row parameter="QUESTION" planning_atom_kind="question"
  row parameter="REFERENCE" planning_atom_kind="reference"
}
