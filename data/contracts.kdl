        field "condition_id" type="id" required=#true
        field "satisfied" type="bool" required=#true
        list "evidence_envelopes" item="artifact_link" required=#true
    }
    record "bughunter_triggers_v1" {
        field "implementation_lanes" type="u32" required=#true
        field "risk" type="string" required=#true
        field "protected_security_data_or_migration" type="bool" required=#true
        field "semantic_conflict_resolution" type="bool" required=#true
        field "operator_required" type="bool" required=#true
    }
}

