artifact "final_gate_assembly" schema="autopilot.final_gate_assembly.v1" producer="Package" model_produced=#false {
    doc "Authoritative derived final gate input; never accepted from Host, operator, or model."
    field "schema_version" type="schema-id" required=#true
    field "repo_key" type="base32" required=#true
    field "run_id" type="uuidv7" required=#true
    field "workstream" type="id" required=#true
    field "basis_event_sequence" type="u64" required=#true
    field "basis_run_revision" type="u64" required=#true
    field "basis_event_log_sha256" type="digest" required=#true
    field "basis_state_hash" type="digest" required=#true
    field "plan_envelope" type="artifact_link" required=#true
    field "final_commit" type="git-oid" required=#true
    field "final_tree" type="git-oid" required=#true
    field "target_ref" type="ref" required=#true
    field "recorded_target_base" type="git-oid" required=#true
    field "observed_target_tip" type="git-oid" required=#true
    list "conditions" item="final_condition_evidence" required=#true
    field "triggers" type="bughunter_triggers_v1" required=#true
    list "accepted_envelopes" item="artifact_link" required=#true
    field "assembly_sha256" type="digest" required=#true
