schema "autopilot.contracts.v1"
version 1

doc "Declarative contract source for Autopilot artifacts, enums, seam frames, prompt-visible admissibility text, and durable categories. Parsed as KDL v2 by kdl crate 6.7."

// Common node shapes used below:
// artifact <name> schema=<schema-id> producer=<Producer> model_produced=<bool> { doc ... admits ... field/group/list/record... }
// field <field-name> type=<type-id> required=<bool> doc=<human text>
// list <field-name> item=<record-or-type-id> required=<bool> doc=<human text>
// enum <name> { value <exact-value> }
// frame direction=<host-to-core|core-to-host> kind=<exact-kind> { ... }

type "uuidv7" doc="UUID version 7 string."
type "digest" doc="Stable digest string from the producing package contract."
type "sha" doc="Git object SHA string where D76 names <sha>."
type "ref" doc="Durable artifact reference, bounded before inclusion in model context."
type "timestamp" doc="Timestamp string; nullable only where the field says <timestamp|null>."
type "id" doc="Package stable identifier string."
type "bytes" doc="Exact command bytes encoded losslessly for transport."
type "task-document-class" doc="Closed task-pack document class string carried into child runner specs."
type "unix-ms" doc="JSON integer Unix epoch milliseconds in 0..=9007199254740991."
type "git-oid" doc="Git object id string for the repository object format."
type "json" doc="Closed JSON value serialized with AP-CJ1 canonical JSON."

artifact "role_frontmatter" schema="autopilot.role.v1" producer="Package" model_produced=#false {
    doc "Strict package-authored YAML frontmatter for role definitions (D76 §2.2)."
    field "schema" type="schema-id" required=#true constant="autopilot.role.v1"
    field "id" type="id" required=#true doc="Role id, for example implementer in D76 §2.2."
    field "version" type="u32" required=#true
    list "modes" item="mode-id" required=#true doc="YAML field modes, for example [lane-delivery]."
    field "model_slot" type="roster_slot" required=#true
    field "thinking" type="thinking-level" required=#true doc="Roster thinking value, for example high/max/xhigh."
    list "tools" item="tool-name" required=#true doc="Exact active tool names supplied in the YAML list."
    group "permissions" required=#true {
        field "repository" type="permission" required=#true
        field "git" type="permission" required=#true
        field "network" type="permission" required=#true
        field "package_state" type="permission" required=#true
        field "operator_checkout" type="permission" required=#true
    }
    field "context_policy" type="contract-id" required=#true
    field "result_contract" type="contract-id" required=#true
    field "checkpoint_contract" type="contract-id" required=#true
}

artifact "context_manifest" schema="autopilot.context_manifest.v1" producer="Package" model_produced=#false {
    doc "Canonical package-written context manifest (D76 §4.1)."
    field "schema" type="schema-id" required=#true constant="autopilot.context_manifest.v1"
    field "manifest_id" type="uuidv7" required=#true
    field "revision" type="u32" required=#true
    field "run_id" type="uuidv7" required=#true
    field "assignment_id" type="id" required=#true
    group "role" required=#true {
        field "id" type="id" required=#true
        field "version" type="u32" required=#true
        field "mode" type="mode-id" required=#true
        field "mode_version" type="u32" required=#true
    }
    group "freshness" required=#true {
        field "task_revision" type="digest" required=#true
        field "plan_revision" type="digest" required=#true
        field "dossier_revision" type="digest" required=#true
        field "runtime_revision" type="u64" required=#true
        field "git_commit" type="sha" required=#true
    }
    group "budget" required=#true {
        field "context_window" type="u32" required=#true
        field "estimated_initial_tokens" type="u32" required=#true
        field "estimated_percent" type="u8" required=#true doc="Conservative estimate; D76 §4.2 routing thresholds are <=40%, >40% and <=50%, and >50%."
        field "estimator" type="string" required=#true constant="conservative-utf8-v1"
    }
    list "mandatory_inline" item="context_item" required=#true doc="Tier 1 delivery list; may be empty []."
    list "required_reads" item="context_item" required=#true doc="Tier 2 delivery list; may be empty []."
    list "on_demand" item="context_item" required=#true doc="Tier 3 delivery list; may be empty []."
    list "excluded" item="context_item" required=#true doc="Excluded context records; may be empty []."
    list "gaps" item="context_gap" required=#true doc="Known context gaps; may be empty []."
    field "curator_proposal_ref" type="ref" required=#true nullable=#true doc="<ref|null> in D76 §4.1."
    record "context_item" {
        field "id" type="id" required=#true
        field "authority_class" type="authority-class" required=#true
        field "source_uri" type="uri" required=#true
        field "anchor" type="context_anchor" required=#true
        field "source_digest" type="digest" required=#true
        field "content_digest" type="digest" required=#true
        field "purpose" type="string" required=#true
        field "linked_criterion" type="id" required=#false nullable=#true
        field "linked_decision" type="id" required=#false nullable=#true
        field "linked_unit" type="id" required=#false nullable=#true
        field "token_estimate" type="u32" required=#true
        field "redaction_state" type="redaction-state" required=#true
    }
    record "context_gap" {
        field "id" type="id" required=#true
        field "missing_fact_or_ref" type="string" required=#true
        field "reason" type="string" required=#true
        field "affected_criterion" type="id" required=#false nullable=#true
        field "affected_decision" type="id" required=#false nullable=#true
        field "known_source" type="uri" required=#false nullable=#true
    }
}

artifact "context_anchor" schema="autopilot.context_anchor.v1" producer="Package" model_produced=#false {
    doc "Validated context anchor pattern set from D76 §4.1. The discriminating field is anchor_form so generated kernel source can avoid embedding domain substrings; literal forms remain data."
    field "anchor_form" type="context_anchor_form" required=#true doc="Do not name this field after any concrete backend; generated kernel code should use generic names."
    field "uri" type="uri" required=#true
    pattern "task-heading" anchor_form="task" value="task://<digest>/<path>#heading=<heading>"
    pattern "plan-unit" anchor_form="plan" value="plan://<revision>/units/<unit-id>"
    pattern "dossier-finding" anchor_form="dossier" value="dossier://<revision>/findings/<finding-id>"
    pattern "run-finding" anchor_form="run" value="run://<run-id>/findings/<finding-id>"
    pattern "vcs-lines" anchor_form="version-control-lines" value="git://<commit>/<path>#L<start>-L<end>" doc="D76 says git line anchors bind the exact blob; data may contain this literal."
    pattern "vcs-whole-file" anchor_form="version-control-whole-file" value="git://<commit>/<path>#whole-file" doc="Whole-file source anchor."
    pattern "json-pointer" anchor_form="json" value="json://<digest>/<path>#/<json-pointer>"
}

artifact "control_frame" schema="autopilot.control_frame.v1" producer="Package" model_produced=#false {
    doc "Bounded package-generated Control Frame (D76 §6.1)."
    field "schema" type="schema-id" required=#true constant="autopilot.control_frame.v1"
    field "frame_id" type="uuidv7" required=#true
    field "run_id" type="uuidv7" required=#true
    field "run_revision" type="u64" required=#true
    group "trigger" required=#true {
        field "kind" type="trigger-kind" required=#true doc="Example from D76: background-completed."
        list "refs" item="ref" required=#true doc="Example from D76: [<action-id>]."
    }
    group "counts" required=#true {
        field "implementers" type="u32" required=#true
        field "validators" type="u32" required=#true
        field "fixers" type="u32" required=#true
        field "deterministic_jobs" type="u32" required=#true
        field "queued_candidates" type="u32" required=#true
    }
    list "observations" item="control_observation" required=#true doc="Bounded observations only; no source diff, broad logs, implementation reasoning, or full plan prose."
    list "actions" item="background_action" required=#true doc="Exact currently valid actions."
    field "next_watchdog_at" type="timestamp" required=#true nullable=#true
    field "return_to_idle" type="bool" required=#true
}

artifact "background_capabilities" schema="autopilot.background_capabilities.v1" producer="Host" model_produced=#false {
    doc "Exact pi-background-tasks extension API capability fact object observed by Host and consumed by Core before any planning/run mutation. v1 generic bg_run fields remain for compatibility; v2 attested fields are required for evidence-backed planning review."
    field "api_version" type="u32" required=#true doc="The paired pi-background-tasks extension API version; 2 is required for attested evidence launch."
    field "run" type="bool" required=#true
    field "run_is_agent" type="bool" required=#true
    field "run_completion_trigger" type="bool" required=#true
    field "status" type="bool" required=#true
    field "logs" type="bool" required=#true
    field "logs_bounded" type="bool" required=#true
    field "kill" type="bool" required=#true
    field "run_attested_pi" type="bool" required=#false doc="v2: exact run-attested-pi operation is available."
    field "attested_idempotency" type="bool" required=#false doc="v2: same idempotency key replays and conflicts loudly."
    field "attested_status_by_idempotency_key" type="bool" required=#false doc="v2: status/reconcile uses the full idempotency key."
    field "attested_terminal_artifacts" type="bool" required=#false doc="v2: terminal observations carry report and sidecar source paths."
    field "report_schema" type="string" required=#false doc="v2 literal phase2.pi_task_report.v1."
    field "attestation_schema" type="string" required=#false doc="v2 literal phase2.pi_task_attestation.v2."
}


artifact "background_action" schema="autopilot.background_action.v1" producer="Package" model_produced=#false {
    doc "Exact background launch/reconcile/stop action descriptor (D76 §6.2 and D74 §4.5). Core-owned authority metadata wraps the public pi-background-tasks bg_run object without Host renaming or synthesis."
    field "action_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "kind" type="action_kind" required=#true
    group "bg_run" required=#true {
        field "name" type="string" required=#true doc="Exact bg_run.name passed to pi-background-tasks."
        field "command" type="bytes" required=#true doc="Byte-fixed bg_run.command; the Host relays this string without PATH lookup or token rewriting."
        field "isAgent" type="bool" required=#true doc="Exact bg_run.isAgent field spelling from Pi background tasks."
        field "timeoutSeconds" type="u32" required=#false doc="Exact optional bg_run.timeoutSeconds selected by Core; omitted when Core selects no timeout; Host rejects null."
        field "notifyOnCompletion" type="bool" required=#true doc="Exact bg_run.notifyOnCompletion field."
        field "triggerOnCompletion" type="bool" required=#true doc="Exact bg_run.triggerOnCompletion field."
    }
    field "run_revision" type="u64" required=#true doc="Expected run revision."
    field "expires_at" type="timestamp" required=#false nullable=#true doc="Expiry for one-time issued action."
    field "supersession_state" type="supersession-state" required=#true doc="Live, superseded, expired, or consumed posture."
}

artifact "autopilot_content_ref" schema="autopilot.content_ref.v1" producer="Package" model_produced=#false {
    doc "Create-once package content reference for evidence artifacts. Paths are package-run-root-relative POSIX paths and hashes cover exact bytes."
    field "schema_version" type="schema-id" required=#true
    field "kind" type="evidence_content_kind" required=#true
    field "path" type="path" required=#true
    field "byte_length" type="unix-ms" required=#true
    field "sha256" type="digest" required=#true
}

artifact "autopilot_event_ref" schema="autopilot.event_ref.v1" producer="Package" model_produced=#false {
    doc "Digest-bound reference to an authoritative EventRow v1 row."
    field "schema_version" type="schema-id" required=#true
    field "sequence" type="u64" required=#true
    field "kind" type="event-kind" required=#true
    field "row_sha256" type="digest" required=#true
}

artifact "autopilot_evidence_conflict_policy" schema="autopilot.evidence_conflict_policy.v1" producer="Package" model_produced=#false {
    doc "Package-authored conflict policy for an attested evidence assignment."
    field "schema_version" type="schema-id" required=#true
    list "distinct_from_receipt_refs" item="autopilot_content_ref" required=#true
    field "forbid_same_assignment" type="bool" required=#true
    field "forbid_same_action" type="bool" required=#true
    field "forbid_same_session" type="bool" required=#true
    field "require_subject_current" type="bool" required=#true
    field "policy_sha256" type="digest" required=#true
}

artifact "phase2_pi_consumer_binding" schema="phase2.pi_consumer_binding.v1" producer="Package" model_produced=#false {
    doc "Closed consumer binding echoed by the paired background producer request, report, and sidecar."
    field "schema_version" type="schema-id" required=#true
    field "consumer" type="string" required=#true
    field "run_id" type="uuidv7" required=#true
    field "repo_key" type="base32" required=#true
    field "workstream" type="id" required=#true
    field "purpose_id" type="id" required=#true
    field "action_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "assignment_revision" type="u32" required=#true
    field "run_revision" type="u64" required=#true
    field "boundary_id" type="contract-id" required=#true
    field "subject_digest" type="digest" required=#true
    field "binding_sha256" type="digest" required=#true
}

artifact "phase2_pi_attested_run_request" schema="phase2.pi_attested_run_request.v2" producer="Package" model_produced=#false {
    doc "Closed EventBus v2 request for paired pi-background-tasks run-attested-pi."
    field "schema_version" type="schema-id" required=#true
    field "name" type="string" required=#true
    field "provider" type="string" required=#true
    field "model" type="string" required=#true
    field "thinking" type="thinking-level" required=#true
    field "system_prompt_utf8" type="string" required=#true
    field "prompt_utf8" type="string" required=#true
    field "report_path" type="path" required=#true
    field "timeout_seconds" type="u32" required=#true
    field "idempotency_key" type="id" required=#true
    field "consumer_binding" type="phase2_pi_consumer_binding" required=#true
    field "request_sha256" type="digest" required=#true
}

artifact "autopilot_attested_assignment" schema="autopilot.attested_assignment.v1" producer="Package" model_produced=#false {
    doc "Core-issued attested evidence assignment. Only Core creates this object and its action."
    field "schema_version" type="schema-id" required=#true
    field "run_id" type="uuidv7" required=#true
    field "repo_key" type="base32" required=#true
    field "workstream" type="id" required=#true
    field "purpose_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "assignment_revision" type="u32" required=#true
    field "run_revision" type="u64" required=#true
    field "action_id" type="id" required=#true
    field "issue_idempotency_key" type="id" required=#true
    field "import_idempotency_key" type="id" required=#true
    field "subject_digest" type="digest" required=#true
    field "boundary_id" type="contract-id" required=#true
    field "provider" type="string" required=#true
    field "model" type="string" required=#true
    field "thinking" type="thinking-level" required=#true
    field "required_channel" type="string" required=#true
    field "prompt_ref" type="autopilot_content_ref" required=#true
    field "system_prompt_sha256" type="digest" required=#true
    field "report_staging_path" type="path" required=#true
    field "producer_request_sha256" type="digest" required=#true
    field "conflict_policy" type="autopilot_evidence_conflict_policy" required=#true
    field "issued_at_unix_ms" type="unix-ms" required=#true
    field "supersedes_assignment_id" type="id" required=#false
    field "assignment_sha256" type="digest" required=#true
}

artifact "autopilot_attested_action" schema="autopilot.attested_action.v1" producer="Package" model_produced=#false {
    doc "Core-issued exact attested action. Host may only relay this object through EventBus v2."
    field "schema_version" type="schema-id" required=#true
    field "action_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "assignment_revision" type="u32" required=#true
    field "run_revision" type="u64" required=#true
    field "assignment_ref" type="autopilot_content_ref" required=#true
    field "producer_request" type="phase2_pi_attested_run_request" required=#true
    field "expires_at_unix_ms" type="unix-ms" required=#true
    field "supersession_state" type="string" required=#true
    field "action_sha256" type="digest" required=#true
}

artifact "autopilot_producer_binding" schema="autopilot.producer_binding.v1" producer="Package" model_produced=#false {
    doc "Core binding between an issued attested action and the producer task/report/sidecar locators returned by EventBus v2."
    field "schema_version" type="schema-id" required=#true
    field "run_id" type="uuidv7" required=#true
    field "workstream" type="id" required=#true
    field "action_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "assignment_revision" type="u32" required=#true
    field "run_revision" type="u64" required=#true
    field "assignment_ref" type="autopilot_content_ref" required=#true
    field "action_ref" type="autopilot_content_ref" required=#true
    field "producer_task_id" type="id" required=#true
    field "producer_request_sha256" type="digest" required=#true
    field "report_source_path" type="path" required=#true
    field "sidecar_source_path" type="path" required=#true
    field "bound_at_unix_ms" type="unix-ms" required=#true
    field "binding_sha256" type="digest" required=#true
}

artifact "autopilot_evidence_conflict_check" schema="autopilot.evidence_conflict_check.v1" producer="Package" model_produced=#false {
    doc "Folded package conflict check over authoritative accepted receipts. All conflict tuples must be empty for acceptance."
    field "schema_version" type="schema-id" required=#true
    list "compared_receipt_refs" item="autopilot_content_ref" required=#true
    list "assignment_conflicts" item="id" required=#true
    list "action_conflicts" item="id" required=#true
    list "session_conflicts" item="id" required=#true
    list "subject_conflicts" item="digest" required=#true
    list "provider_channel_conflicts" item="string" required=#true
    field "status" type="string" required=#true
    field "check_sha256" type="digest" required=#true
}

artifact "autopilot_evidence_acceptance_receipt" schema="autopilot.evidence_acceptance_receipt.v1" producer="Package" model_produced=#false {
    doc "Versioned immutable acceptance receipt for an imported attested report and sidecar."
    field "schema_version" type="schema-id" required=#true
    field "receipt_id" type="id" required=#true
    field "run_id" type="uuidv7" required=#true
    field "repo_key" type="base32" required=#true
    field "workstream" type="id" required=#true
    field "purpose_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "action_id" type="id" required=#true
    field "assignment_revision" type="u32" required=#true
    field "run_revision" type="u64" required=#true
    field "subject_digest" type="digest" required=#true
    field "boundary_id" type="contract-id" required=#true
    field "assignment_ref" type="autopilot_content_ref" required=#true
    field "action_ref" type="autopilot_content_ref" required=#true
    field "producer_binding_ref" type="autopilot_content_ref" required=#true
    field "report_ref" type="autopilot_content_ref" required=#true
    field "producer_sidecar_ref" type="autopilot_content_ref" required=#true
    field "producer_task_id" type="id" required=#true
    field "producer_request_sha256" type="digest" required=#true
    field "prompt_sha256" type="digest" required=#true
    field "system_prompt_sha256" type="digest" required=#true
    field "payload_sha256" type="digest" required=#true
    field "provider" type="string" required=#true
    field "model" type="string" required=#true
    field "channel" type="string" required=#true
    field "auth_class" type="string" required=#true
    field "credential_kind" type="string" required=#true
    field "direct_api_key" type="bool" required=#true
    field "pi_session_id" type="id" required=#true
    field "conflict_check" type="autopilot_evidence_conflict_check" required=#true
    field "issue_idempotency_key" type="id" required=#true
    field "import_idempotency_key" type="id" required=#true
    field "issue_event_ref" type="autopilot_event_ref" required=#true
    field "binding_event_ref" type="autopilot_event_ref" required=#true
    field "supersession_state_at_acceptance" type="string" required=#true
    field "accepted_at_unix_ms" type="unix-ms" required=#true
    field "receipt_sha256" type="digest" required=#true
}

artifact "autopilot_evidence_failure_receipt" schema="autopilot.evidence_failure_receipt.v1" producer="Package" model_produced=#false {
    doc "Immutable failure/rejection/conflict receipt. Rejected bytes are not imported."
    field "schema_version" type="schema-id" required=#true
    field "run_id" type="uuidv7" required=#true
    field "workstream" type="id" required=#true
    field "purpose_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "action_id" type="id" required=#true
    field "assignment_revision" type="u32" required=#true
    field "run_revision" type="u64" required=#true
    field "state" type="string" required=#true
    field "code" type="evidence_error_code" required=#true
    list "expected_refs" item="autopilot_content_ref" required=#true
    list "observed_hashes" item="digest" required=#true
    field "occurred_at_unix_ms" type="unix-ms" required=#true
    field "failure_sha256" type="digest" required=#true
}

artifact "autopilot_evidence_supersession_receipt" schema="autopilot.evidence_supersession_receipt.v1" producer="Package" model_produced=#false {
    doc "Immutable supersession receipt. Acceptance receipts are never rewritten."
    field "schema_version" type="schema-id" required=#true
    field "run_id" type="uuidv7" required=#true
    field "workstream" type="id" required=#true
    field "purpose_id" type="id" required=#true
    field "old_assignment_ref" type="autopilot_content_ref" required=#true
    field "new_assignment_ref" type="autopilot_content_ref" required=#true
    field "old_acceptance_receipt_ref" type="autopilot_content_ref" required=#false
    field "old_assignment_revision" type="u32" required=#true
    field "new_assignment_revision" type="u32" required=#true
    field "reason" type="string" required=#true
    field "superseded_at_event_revision" type="u64" required=#true
    field "supersession_idempotency_key" type="id" required=#true
    field "supersession_sha256" type="digest" required=#true
}

artifact "autopilot_transcript_v2" schema="autopilot.transcript.v2" producer="Package" model_produced=#false {
    doc "Receipt-backed non-authoritative replay transcript fixture. V1 transcripts remain compatibility-only."
    field "schema_version" type="schema-id" required=#true
    field "boundary_id" type="contract-id" required=#true
    field "payload_utf8" type="string" required=#true
    field "payload_sha256" type="digest" required=#true
    field "acceptance_receipt_ref" type="autopilot_content_ref" required=#true
    field "producer_sidecar_ref" type="autopilot_content_ref" required=#true
    field "transcript_sha256" type="digest" required=#true
}

artifact "autopilot_evidence_envelope_manifest" schema="autopilot.evidence_envelope_manifest.v1" producer="Package" model_produced=#false {
    doc "Closed evidence envelope manifest. Members are exactly refs reachable from authoritative evidence events; scans/globs/prefixes are forbidden."
    field "schema_version" type="schema-id" required=#true
    field "manifest_id" type="id" required=#true
    field "run_id" type="uuidv7" required=#true
    field "repo_key" type="base32" required=#true
    field "workstream" type="id" required=#true
    field "scope" type="string" required=#true
    field "manifest_revision" type="u32" required=#true
    field "subject_digest" type="digest" required=#true
    field "previous_manifest_ref" type="autopilot_content_ref" required=#false
    field "closed_through_event_sequence" type="u64" required=#true
    field "event_prefix_sha256" type="digest" required=#true
    list "members" item="autopilot_content_ref" required=#true
    list "active_acceptance_receipt_refs" item="autopilot_content_ref" required=#true
    list "supersession_receipt_refs" item="autopilot_content_ref" required=#true
    list "failure_receipt_refs" item="autopilot_content_ref" required=#true
    field "excluded_self" type="bool" required=#true
    field "closed_at_unix_ms" type="unix-ms" required=#true
    field "manifest_sha256" type="digest" required=#true
}


artifact "task_document" schema="autopilot.task_document.v1" producer="Package" model_produced=#false {
    doc "Core-classified task-pack document copied into child runner specs. The digest is over the exact admitted file bytes; body_digest is over the model-visible body only."
    field "path" type="path" required=#true
    field "class" type="task-document-class" required=#true
    field "digest" type="digest" required=#true
    field "body_digest" type="digest" required=#true
    field "body" type="string" required=#true
}

artifact "agent_run_spec" schema="autopilot.agent_run_spec.v1" producer="Package" model_produced=#false {
    doc "Strict parent-Core written child runner specification for the package-contained autopilot-agent-run wrapper and Rust agent-run mode."
    field "schema" type="schema-id" required=#true constant="autopilot.agent_run_spec.v1"
    field "assignment_kind" type="validation_assignment_kind" required=#true doc="Explicit assignment class; no runner infers planning/delivery/validation from result_contract."
    field "action_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "run_revision" type="u64" required=#true
    field "workstream" type="id" required=#true
    field "role_id" type="id" required=#true
    field "mode" type="mode-id" required=#true
    field "provider" type="string" required=#true
    field "model" type="string" required=#true
    field "thinking" type="thinking-level" required=#true
    field "route" type="string" required=#true
    field "cwd" type="path" required=#true
    list "allowed_tools" item="tool-name" required=#true
    field "spec_path" type="path" required=#true
    field "prompt_path" type="path" required=#true
    field "prompt_digest" type="digest" required=#true
    field "boundary_id" type="contract-id" required=#true
    field "boundary_digest" type="digest" required=#true
    field "result_contract" type="contract-id" required=#true
    field "result_contract_digest" type="digest" required=#true
    field "carrier_path" type="path" required=#true
    field "session_id" type="id" required=#true doc="Stable pi --session-id derived from typed assignment identity; reused for value-repair turns and resume."
    field "settings_digest" type="digest" required=#true
    field "context_digest" type="digest" required=#true
    field "skills_digest" type="digest" required=#true
    field "subscription_digest" type="digest" required=#true
    field "lane_id" type="id" required=#false nullable=#true
    field "attempt" type="u32" required=#false nullable=#true
    field "base_commit" type="sha" required=#false nullable=#true
    field "worktree" type="path" required=#false nullable=#true
    field "required_focused_evidence" type="u32" required=#false nullable=#true
    field "authority_set_id" type="string" required=#false nullable=#true
    list "authority_documents" item="task_document" required=#false nullable=#true
    field "context_document" type="task_document" required=#false nullable=#true
    field "assignment_path" type="path" required=#false nullable=#true
    field "assignment_digest" type="digest" required=#false nullable=#true
    field "context_manifest_path" type="path" required=#false nullable=#true
    field "context_manifest_digest" type="digest" required=#false nullable=#true
    field "runtime_extension_path" type="path" required=#false nullable=#true
    field "runtime_extension_digest" type="digest" required=#false nullable=#true
    list "producer_assignment_ids" item="id" required=#false nullable=#true
    field "validation_id" type="id" required=#false nullable=#true
    field "validation_attempt" type="u32" required=#false nullable=#true
    field "semantic_round" type="u32" required=#false nullable=#true
    field "model_submission_path" type="path" required=#false nullable=#true
    field "atom_id_prefix" type="string" required=#false nullable=#true
    field "atom_registry_path" type="path" required=#false nullable=#true
    field "atom_registry_digest" type="digest" required=#false nullable=#true
    field "planning_inputs_path" type="path" required=#false nullable=#true
    field "planning_inputs_digest" type="digest" required=#false nullable=#true
}

artifact "run_identity" schema="autopilot.run_identity.v1" producer="Package" model_produced=#false {
    doc "Clean v2 runtime identity namespace (D76 §5.1)."
    field "repo_key" type="base32" required=#true doc="lowercase-base32(sha256(\"autopilot-repo-v1\\0\" + realpath(git-common-dir)))"
    field "run_id" type="uuidv7" required=#true doc="UUIDv7 run-id."
    field "workstream" type="id" required=#true
    constant "runtime_root" value="~/.pi/agent/autopilot/v2/"
    constant "repo_key_derivation" value="lowercase-base32(sha256(\"autopilot-repo-v1\\0\" + realpath(git-common-dir)))"
    constant "run_id_derivation" value="UUIDv7"
}

artifact "event_row" schema="autopilot.event_row.v1" producer="Package" model_produced=#false {
    doc "Append-only event row; events.jsonl is the sole state authority (D76 §5.4 + D77 Closure B)."
    field "sequence" type="u64" required=#true doc="Monotonic sequence."
    field "previous_revision" type="u64" required=#true
    field "new_revision" type="u64" required=#true
    field "kind" type="event-kind" required=#true
    list "artifact_refs" item="ref" required=#true doc="Bounded artifact refs."
}

artifact "state_cache" schema="autopilot.state_cache.v1" producer="Package" model_produced=#false {
    doc "Disposable cache only, never an authority. State is fold(events); this cache may be deleted at any instant with zero semantic loss and any mismatch forces full replay (D77 Closure B)."
    field "sequence" type="u64" required=#true
    field "state_hash" type="digest" required=#true
}

artifact "agent_handoff" schema="autopilot.agent-handoff.v1" producer="Model" model_produced=#true {
    doc "Model-facing checkpoint handoff. The package preserves unknown top-level properties and validates role-required critical_state slots from data/checkpoint-policy.kdl before compaction/resume."
    admits "When checkpointed, return one autopilot.agent-handoff.v1 object with exactly these required fields: schema, completed, remaining, critical_state, and next_action. Put finished obligations in completed, unfinished obligations in remaining, role-required scalar or array-of-scalar slots in critical_state, and the immediate resume instruction in next_action; do not invent completion."
    field "schema" type="schema-id" required=#true constant="autopilot.agent-handoff.v1"
    list "completed" item="string" required=#true doc="Bounded finished obligations/results that must survive compaction."
    list "remaining" item="string" required=#true doc="Bounded unfinished obligations/results that must survive compaction."
    field "critical_state" type="object" required=#true doc="Role-specific slots; values must be scalar or arrays of scalar as declared in checkpoint-policy.kdl."
    field "next_action" type="string" required=#true doc="Immediate next action after resume."
}

artifact "task_atoms" schema="planning.task-atoms.v1" producer="Model" model_produced=#true {
    doc "Model-facing task atom submission. Shape is deliberately small: structure is enforced by the submit tool; source values are checked against task authority anchors by the planning driver."
    admits "Task extractor output must use the exact runner-issued atom id prefix for every atoms[].id, name operator-task atoms with source anchors, and include no repository findings. Call autopilot_submit_atoms as the final action with atoms containing id, kind, text, and sources."
    list "atoms" item="task_atom" required=#true doc="Task atoms; may be empty only when no task authority text exists."
    record "task_atom" {
        field "id" type="id" required=#true
        field "kind" type="planning_atom_kind" required=#true
        field "text" type="string" required=#true
        list "sources" item="ref" required=#true doc="Task-document anchors supplied by the package."
    }
}

artifact "planning_atom_registry" schema="autopilot.planning_atom_registry.v1" producer="Package" model_produced=#false {
    doc "Create-once accepted task atom registry materialized by the seam after task extractors are accepted."
    field "schema" type="schema-id" required=#true constant="autopilot.planning_atom_registry.v1"
    field "workstream" type="id" required=#true
    field "authority_set_id" type="string" required=#true
    list "producer_assignment_ids" item="id" required=#true
    list "atoms" item="planning_atom_registry_atom" required=#true
    record "planning_atom_registry_atom" {
        field "id" type="id" required=#true
        field "producer_assignment_id" type="id" required=#true
        field "kind" type="planning_atom_kind" required=#true
        field "text" type="string" required=#true
        list "sources" item="ref" required=#true
    }
}

artifact "scout_dossier" schema="planning.scout-dossier.v1" producer="Model" model_produced=#true {
    doc "Model-facing repository scout dossier. Shape is small; path values are checked against the pinned repository commit by the planning driver."
    admits "Repository scout and dossier output must cite current evidence and avoid work planning. Call autopilot_submit_scout_report as the final action with findings containing path, observation, and evidence_ref."
    list "findings" item="scout_finding" required=#true doc="Repository findings grounded in current evidence."
    record "scout_finding" {
        field "path" type="path" required=#true
        field "observation" type="string" required=#true
        field "evidence_ref" type="ref" required=#true
    }
}

artifact "questions" schema="planning.questions.v1" producer="Model" model_produced=#true {
    doc "Model-facing contradiction/question nominations. Empty questions are valid when no material unresolved issue remains."
    admits "Question output must be an explicit questions array, which may be empty, or structured nominations. Each nomination must include class, evidence, and consequence. The class field is closed to: invalidated-decision, missing-material-decision, material-underdetermination, dod-hole, unsafe-irreversible."
    list "questions" item="planning_question" required=#true doc="Material operator questions; [] is an accepted empty set."
    record "planning_question" {
        field "class" type="planning_question_class" required=#true
        field "evidence" type="string" required=#true
        field "consequence" type="string" required=#true
    }
}

artifact "work_map" schema="planning.work-map.v1" producer="Model" model_produced=#true {
    doc "Model-facing work map. Link values are checked against the accepted atom registry by the planning driver."
    admits "Plan compiler and synthesizer output must contain one or more units. Each unit must have an objective, acceptance criteria, and traceable links by real atom id. Call autopilot_submit_plan_cluster or autopilot_submit_synthesis as the final action."
    list "units" item="plan_unit" required=#true doc="Executable plan units."
    record "plan_unit" {
        field "id" type="id" required=#true
        field "objective" type="string" required=#true
        list "criteria" item="string" required=#true
        list "links" item="id" required=#true doc="Atom ids accepted from task_atoms."
    }
}

artifact "plan_review" schema="planning.plan-review.v1" producer="Model" model_produced=#true {
    doc "Model-facing plan review verdicts. Verdict is closed; finding text is optional and advisory unless the verdict requires explanation."
    admits "Plan review output must assign a verdict to each criterion using pass, blocker, advisory, fail, blocked, or needs-fix. It must include at least one verdict. Call autopilot_submit_review as the final action."
    list "verdicts" item="plan_review_verdict" required=#true doc="Criterion verdicts."
    record "plan_review_verdict" {
        field "criterion_id" type="id" required=#true
        field "verdict" type="planning_review_verdict" required=#true
        field "finding" type="string" required=#false
    }
}

artifact "allocation_lane_proposal" schema="autopilot.allocation_lane_proposal.v1" producer="Model" model_produced=#true {
    doc "Allocator model proposal; package validates totality, dependencies, cap, and no invented ownership (D76 §7)."
    admits "Return a lane proposal that groups only approved plan units. Preserve every unit id, dependency, predecessor forward criterion, downstream release edge, and verification obligation exactly as supplied. Do not invent file ownership or modify plan authority. Include ordered unit ids, one delivery boundary, context family id and estimate, focused tests, and launch wave."
    field "lane_id" type="id" required=#true
    field "objective" type="string" required=#true
    list "ordered_unit_ids" item="id" required=#true
    field "rationale" type="string" required=#true
    field "delivery_boundary" type="delivery-boundary" required=#true
    list "predecessor_forward_criteria" item="id" required=#true
    list "downstream_release_edges" item="id" required=#true
    field "context_family_id" type="id" required=#true
    field "context_estimate" type="u32" required=#true doc="Estimated starting context usage/tokens."
    list "focused_tests" item="test-id" required=#true
    field "launch_wave" type="u32" required=#true
    field "continue_existing_logical_lane" type="bool" required=#false nullable=#true
}

artifact "delivery_result" schema="autopilot.delivery_result.v1" producer="Model" model_produced=#true {
    doc "Implementer/Fixer terminal delivery carrier pending package acceptance (D76 §8.2)."
    admits "Submit exactly one terminal delivery carrier for your assigned role, mode, assignment, attempt, and run revision. Report the exact base, worktree, actual changed paths, execution audit reference, and required focused evidence. Do not claim validation, merge, package commit/tree, package state mutation, or success hidden behind missing evidence. The runtime establishes package commit/tree after accepting this carrier. If any hard boundary was violated or required evidence is missing, say so instead of reporting DONE."
    field "assignment_id" type="id" required=#true
    field "role_id" type="id" required=#true
    field "mode" type="mode-id" required=#true
    field "run_revision" type="u64" required=#true
    field "lane_id" type="id" required=#true
    field "attempt" type="u32" required=#true
    field "base_commit" type="sha" required=#true
    field "worktree" type="path" required=#true
    field "action_id" type="id" required=#false nullable=#true
    field "prompt_path" type="path" required=#false nullable=#true
    field "prompt_digest" type="digest" required=#false nullable=#true
    field "spec_path" type="path" required=#false nullable=#true
    field "spec_digest" type="digest" required=#false nullable=#true
    field "carrier_path" type="path" required=#false nullable=#true
    field "boundary_digest" type="digest" required=#false nullable=#true
    field "result_contract_digest" type="digest" required=#false nullable=#true
    field "settings_digest" type="digest" required=#false nullable=#true
    field "context_digest" type="digest" required=#false nullable=#true
    field "skills_digest" type="digest" required=#false nullable=#true
    field "subscription_digest" type="digest" required=#false nullable=#true
    field "package_commit" type="sha" required=#false nullable=#true
    field "package_tree" type="sha" required=#false nullable=#true
    list "actual_changed_paths" item="path" required=#true
    field "execution_audit_ref" type="ref" required=#true
    list "focused_evidence_refs" item="ref" required=#true
    field "terminal_status" type="delivery-terminal-status" required=#true
    list "hard_boundary_violations" item="string" required=#true
}

artifact "validation_verdict" schema="autopilot.validation_verdict.v1" producer="Model" model_produced=#true {
    doc "Independent validation verdict bundle for forward, closure, conflict, delta, or final review (D76 §9.2)."
    admits "Verdict every required criterion independently as PASS, FAIL, or BLOCKED, and attach evidence refs, finding refs, covered paths, semantic surfaces, and forward-edge ids. Do not issue an overall PASS while any required criterion is unverdicted, stale, failed, or blocked. Use FORWARD_READY, FORWARD_BLOCKED, or BLOCKED only for forward validation, and PASS, NEEDS_FIX, or BLOCKED only for closure/final validation."
    field "assignment_id" type="id" required=#true
    field "validation_scope" type="validation-scope" required=#true
    field "exact_commit" type="sha" required=#true
    field "exact_tree" type="sha" required=#true
    field "forward_verdict" type="forward_verdict" required=#false nullable=#true
    field "closure_verdict" type="closure_verdict" required=#false nullable=#true
    list "criterion_results" item="criterion_result" required=#true
    list "finding_refs" item="ref" required=#true
    record "criterion_result" {
        field "criterion_id" type="id" required=#true
        field "verdict" type="criterion_verdict" required=#true
        list "evidence_refs" item="ref" required=#true
        list "finding_refs" item="ref" required=#true
        list "covered_paths" item="path" required=#true
        list "semantic_surface_ids" item="id" required=#true
        list "forward_edge_ids" item="id" required=#true
    }
}

artifact "finding" schema="autopilot.finding.v1" producer="Model" model_produced=#true {
    doc "Validator/Bughunter/Fixer finding with semantic scheduling effect (D76 §5.3 and D74 §11.2)."
    admits "For each material issue, record one effect: forward-blocking, closure-blocking-forward-safe, or advisory. Tie the finding to exact criteria or forward edges and evidence. Do not use severity alone to decide scheduling, do not hide a mandatory blocker as advisory, and do not report a source repair requirement without the evidence that makes it mandatory."
    field "finding_id" type="id" required=#true
    field "effect" type="finding_effect" required=#true
    field "summary" type="string" required=#true
    field "detail" type="string" required=#true
    list "criterion_ids" item="id" required=#true
    list "edge_ids" item="id" required=#true
    list "evidence_refs" item="ref" required=#true
    list "covered_paths" item="path" required=#true
    list "semantic_surface_ids" item="id" required=#true
}

artifact "validation_assignment_v2" schema="autopilot.validation_assignment.v1" producer="Package" model_produced=#false {
    doc "Package-produced independent Validator assignment. Production validation uses v2 submissions/results; v1 verdicts remain historical."
    field "schema" type="schema-id" required=#true
    field "validation_id" type="id" required=#true
    field "validation_key" type="digest" required=#true
    field "workstream" type="id" required=#true
    field "run_revision" type="u64" required=#true
    field "role_id" type="id" required=#true
    field "mode" type="mode-id" required=#true
    field "assignment_id" type="id" required=#true
    field "action_id" type="id" required=#true
    field "validation_attempt" type="u32" required=#true
    field "semantic_round" type="u32" required=#true
    field "scope" type="validation_scope_v2" required=#true
    field "subject_kind" type="validation_subject_kind" required=#true
    list "producer_assignment_ids" item="id" required=#true
    list "producer_result_refs" item="ref" required=#true
    field "lane_id" type="id" required=#false
    field "candidate_id" type="id" required=#false
    field "exact_commit" type="git-oid" required=#true
    field "exact_tree" type="git-oid" required=#true
    field "candidate_root" type="path" required=#true
    field "forward_round" type="u32" required=#false
    field "criteria_manifest_ref" type="ref" required=#true
    field "criteria_manifest_digest" type="digest" required=#true
    field "evidence_manifest_ref" type="ref" required=#true
    field "evidence_manifest_digest" type="digest" required=#true
    field "diff_ref" type="ref" required=#true
    field "diff_digest" type="digest" required=#true
    field "prior_result_ref" type="ref" required=#false
    list "prior_finding_refs" item="ref" required=#true
    list "allowed_read_roots" item="path" required=#true
    list "allowed_command_ids" item="id" required=#true
    field "max_transport_attempts" type="u32" required=#true
}

artifact "finding_v2" schema="autopilot.finding.v2" producer="Model" model_produced=#true {
    doc "Embedded v2 validation finding with deterministic validation-id ordinal identifier."
    admits "For each material issue, emit one deterministic finding id, classify kind/effect honestly, tie it to declared criteria/edges/evidence, and never hide a required blocker as advisory."
    field "finding_id" type="id" required=#true
    field "kind" type="finding_kind_v2" required=#true
    field "effect" type="finding_effect" required=#true
    field "summary" type="string" required=#true
    field "detail" type="string" required=#true
    list "criterion_ids" item="id" required=#true
    list "edge_ids" item="id" required=#true
    list "evidence_refs" item="ref" required=#true
    list "covered_paths" item="path" required=#true
    list "semantic_surface_ids" item="id" required=#true
}

artifact "validation_context_v2" schema="autopilot.validation_context.v1" producer="Package" model_produced=#false {
    doc "Canonical fact-only Validator context. Forbidden producer reasoning/session classes are listed explicitly."
    field "schema" type="schema-id" required=#true
    field "context_id" type="id" required=#true
    field "revision" type="u32" required=#true
    field "validation_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "exact_commit" type="git-oid" required=#true
    field "exact_tree" type="git-oid" required=#true
    group "candidate" required=#true {
        field "source_root" type="path" required=#true
        field "diff_ref" type="ref" required=#true
        field "diff_digest" type="digest" required=#true
        list "actual_changed_paths" item="path" required=#true
        field "execution_audit_ref" type="ref" required=#true
    }
    list "criteria" item="validation_context_criterion" required=#true
    list "evidence" item="validation_context_evidence" required=#true
    list "prior_findings" item="finding_v2" required=#true
    list "applicable_decision_refs" item="ref" required=#true
    list "applicable_constraint_refs" item="ref" required=#true
    list "included_context_classes" item="string" required=#true
    list "forbidden_context_classes" item="string" required=#true
    list "allowed_read_roots" item="path" required=#true
    list "excluded_refs" item="validation_excluded_ref" required=#true
    record "validation_context_criterion" {
        field "criterion_id" type="id" required=#true
        field "mandatory" type="bool" required=#true
        list "covered_paths" item="path" required=#true
        list "semantic_surface_ids" item="id" required=#true
        list "forward_edge_ids" item="id" required=#true
        list "witness_ids" item="id" required=#true
    }
    record "validation_context_evidence" {
        field "evidence_ref" type="ref" required=#true
        field "digest" type="digest" required=#true
        field "kind" type="string" required=#true
        field "exact_commit" type="git-oid" required=#true
        field "exact_tree" type="git-oid" required=#true
        field "command_id" type="id" required=#false
    }
    record "validation_excluded_ref" {
        field "ref" type="ref" required=#true
        field "reason" type="string" required=#true
    }
}

artifact "validation_submission_v2" schema="autopilot.validation_submission.v2" producer="Model" model_produced=#true {
    doc "Only payload accepted by the Validator terminal tool. Assistant-text JSON without the terminal tool is not a carrier."
    admits "Call autopilot_emit_status exactly once with this closed JSON object. Verdict every required criterion exactly once, cite only declared evidence refs, embed every finding, and do not claim PASS/READY when Core would compute a material blocker."
    field "schema" type="schema-id" required=#true
    field "validation_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "scope" type="validation_scope_v2" required=#true
    field "exact_commit" type="git-oid" required=#true
    field "exact_tree" type="git-oid" required=#true
    field "outcome" type="validation_outcome_v2" required=#true
    list "criterion_results" item="criterion_result_v2" required=#true
    list "findings" item="finding_v2" required=#true
    record "criterion_result_v2" {
        field "criterion_id" type="id" required=#true
        field "verdict" type="criterion_verdict" required=#true
        field "blocker_kind" type="validation_blocker_kind" required=#false
        list "evidence_refs" item="ref" required=#true
        list "finding_ids" item="id" required=#true
        list "covered_paths" item="path" required=#true
        list "semantic_surface_ids" item="id" required=#true
        list "forward_edge_ids" item="id" required=#true
    }
}

artifact "validation_result_v2" schema="autopilot.validation_result.v2" producer="Package" model_produced=#false {
    doc "Package-bound Validator carrier written create-once after validating model submission and immutable runner binding."
    field "schema" type="schema-id" required=#true
    field "action_id" type="id" required=#true
    field "assignment_id" type="id" required=#true
    field "validation_id" type="id" required=#true
    field "validation_key" type="digest" required=#true
    field "validation_attempt" type="u32" required=#true
    field "semantic_round" type="u32" required=#true
    field "run_revision" type="u64" required=#true
    field "workstream" type="id" required=#true
    field "role_id" type="id" required=#true
    field "mode" type="mode-id" required=#true
    list "producer_assignment_ids" item="id" required=#true
    field "exact_commit" type="git-oid" required=#true
    field "exact_tree" type="git-oid" required=#true
    field "assignment_path" type="path" required=#true
    field "assignment_digest" type="digest" required=#true
    field "context_manifest_path" type="path" required=#true
    field "context_manifest_digest" type="digest" required=#true
    field "prompt_path" type="path" required=#true
    field "prompt_digest" type="digest" required=#true
    field "spec_path" type="path" required=#true
    field "spec_digest" type="digest" required=#true
    field "carrier_path" type="path" required=#true
    field "boundary_id" type="contract-id" required=#true
    field "boundary_digest" type="digest" required=#true
    field "result_contract" type="contract-id" required=#true
    field "result_contract_digest" type="digest" required=#true
    field "settings_digest" type="digest" required=#true
    field "skills_digest" type="digest" required=#true
    field "subscription_digest" type="digest" required=#true
    field "runtime_extension_digest" type="digest" required=#true
    field "tool_audit_ref" type="ref" required=#true
    field "tool_audit_digest" type="digest" required=#true
    field "submission_digest" type="digest" required=#true
    field "submission" type="validation_submission_v2" required=#true
}


artifact "seam_envelope" schema="autopilot.seam_envelope.v1" producer="Host" model_produced=#false {
    doc "D78 §3.1 newline-delimited JSON frame envelope over stdio."
    field "v" type="u32" required=#true constant="1"
    field "id" type="u64" required=#true
    field "kind" type="string" required=#true
    field "payload" type="object" required=#true
}

constant "guard_timeout_default" value="5s" doc="D78 §3.3 default guard-query timeout. On timeout or Core unavailability the Host denies fail-closed."

artifact "artifact_link" schema="autopilot.artifact_link.v1" producer="Package" model_produced=#false {
    doc "Digest-bound run-root artifact link used by finalization assemblies and archive manifests."
    field "schema_version" type="schema-id" required=#true
    field "path" type="path" required=#true
    field "artifact_schema" type="string" required=#true
    field "byte_length" type="u64" required=#true
    field "sha256" type="digest" required=#true
}

artifact "accepted_evidence_envelope" schema="autopilot.accepted_evidence_envelope.v1" producer="Package" model_produced=#false {
    doc "Authoritative accepted evidence envelope. External-attested advisory origin is archived but cannot satisfy final conditions."
    field "schema_version" type="schema-id" required=#true
    field "repo_key" type="base32" required=#true
    field "run_id" type="uuidv7" required=#true
    field "workstream" type="id" required=#true
