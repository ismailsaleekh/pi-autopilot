    field "assignment_id" type="id" required=#false
    field "action_id" type="id" required=#false
    field "role_id" type="id" required=#false
    field "mode" type="mode-id" required=#false
    field "accepted_run_revision" type="u64" required=#true
    field "exact_commit" type="git-oid" required=#false
    field "exact_tree" type="git-oid" required=#false
    field "provider" type="string" required=#false
    field "model" type="string" required=#false
    field "thinking" type="thinking-level" required=#false
    field "route" type="string" required=#false
    field "pi_session_id" type="id" required=#false
