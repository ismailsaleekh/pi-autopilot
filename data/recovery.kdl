recovery version="v1" {
  timeout name="cooperative-handoff" seconds=120
  timeout name="integration-operation" seconds=1800

  lock scope="assignment" backend="os-create-new-file" duplicate="visible-wait" live-holder="no-age-kill"

  value_repair scope="agent-run" max_attempts=3 retry_prompt="typed-diff" exhaustion="paused-operator-decision" session="same-session-id"

  // Launch-side upstream refusals (provider capacity exhausted) produce no
  // content and bill no tokens, so value repair cannot apply: the identical
  // prompt must simply be re-sent later on the same session. Jitter is
  // required because a wave launches its children within milliseconds, and an
  // unjittered backoff would re-synchronise them into a second burst.
  upstream_capacity_retry scope="agent-run" max_retries=4 base_delay_ms=2000 max_delay_ms=30000 jitter="deterministic-per-assignment" session="same-session-id"

  terminal_continuation scope="agent-run" max_attempts=2 trigger="terminal-miss" retryable_classes="prose-instead-of-terminal empty-stop-no-terminal" terminal_classes="no-terminal-frame terminal-tool-not-offered multiple-terminals" retry_prompt="terminal-directive" session="same-session-id" exhaustion="fail-loud"

  r13 number=1 name="planning" status="live"
  r13 number=2 name="normal execution" status="live"
  r13 number=3 name="forward release" status="live"
  r13 number=4 name="two-round blocker" status="live"
  r13 number=5 name="outside-cap quality" status="live"
  r13 number=6 name="context continuation" status="live"
  r13 number=7 name="post-release repair" status="live"
  r13 number=8 name="conflict" status="live"
  r13 number=9 name="background shutdown" status="live"
  r13 number=10 name="integration crash" status="live"
  r13 number=11 name="target movement" status="live"
  r13 number=12 name="unsafe operation" status="live"
  r13 number=13 name="abort" status="live"
  r13 number=14 name="close" status="live"
}
