context_policy schema="autopilot.context_policy.v1" revision=1 {
    role id="implementer" mode="lane-delivery" {
        mandatory_inline "task-authority"
        mandatory_inline "approved-plan-unit"
        mandatory_inline "acceptance-criteria"
        required_reads "dossier-findings"
        required_reads "runtime-identity"
        on_demand "source-anchor"
    }
    role id="validator" mode="forward-release" {
        mandatory_inline "acceptance-criteria"
        mandatory_inline "approved-plan-unit"
        required_reads "delivery-evidence"
        required_reads "source-anchor"
        on_demand "dossier-findings"
    }
    role id="validator" mode="deep-closure" {
        mandatory_inline "acceptance-criteria"
        required_reads "closure-evidence"
        required_reads "source-anchor"
        on_demand "dossier-findings"
    }
    role id="validator" mode="delta-revalidation" {
        mandatory_inline "prior-findings"
        mandatory_inline "acceptance-criteria"
        required_reads "delta-evidence"
        required_reads "source-anchor"
        on_demand "dossier-findings"
    }
    role id="validator" mode="conflict-review" {
        mandatory_inline "conflict-resolution"
        mandatory_inline "acceptance-criteria"
        required_reads "conflict-evidence"
        required_reads "source-anchor"
        on_demand "dossier-findings"
    }
    role id="validator" mode="final-review" {
        mandatory_inline "final-dod"
        mandatory_inline "acceptance-criteria"
        required_reads "final-command-evidence"
        required_reads "source-anchor"
        on_demand "dossier-findings"
    }
    role id="fixer" mode="targeted-repair" {
        mandatory_inline "blocking-finding"
        mandatory_inline "approved-plan-unit"
        mandatory_inline "acceptance-criteria"
        required_reads "delivery-evidence"
        required_reads "source-anchor"
        on_demand "dossier-findings"
    }
    role id="curator" mode="context-reprioritization" {
        mandatory_inline "budget-overage"
        mandatory_inline "authority-index"
        required_reads "context-gaps"
        required_reads "manifest-revision"
        on_demand "source-anchor"
    }
}
