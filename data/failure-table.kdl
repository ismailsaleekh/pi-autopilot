schema "autopilot.failure_table.v1"
version 1

doc "D77 §3.4 closed failure taxonomy. Rows with variant=NotFailure intentionally have no Failure variant. Boundary docs keep D76 wording that kernel source must not spell."

row "missing-malformed-planning-submission" variant="Recoverable" route="Tier1" doc="Missing/malformed planning submission."
row "typed-model-rejection" variant="Recoverable" route="Tier1" doc="A structurally admitted model result is rejected by an independent semantic gate; one phase-bound Recovery Engineer may investigate and repair under original authority before the unchanged gate reruns."
row "missing-pi-background-tasks" variant="Paused" needs="SupplyCapability" doc="Missing pi-background-tasks."
row "child-crash-timeout-background-kill" variant="Transient" retry="Backoff" doc="Child crash / timeout / background kill."
row "missing-invalid-terminal-output" variant="Recoverable" route="Tier1" doc="Missing/invalid terminal output."
row "context-85-percent" variant="NotFailure" doc="Context ≥ 85% is not a failure; it uses the normal checkpoint path."
row "failed-focused-tests" variant="Recoverable" route="Tier1" doc="Failed focused tests."
row "forward-validator-blocker" variant="Recoverable" route="Tier2" escalates_to="Tier3" doc="Forward Validator blocker; Tier 2/3 after round two."
row "closure-validator-findings" variant="Recoverable" route="Tier2" doc="Closure Validator findings."
row "merge-conflict-semantic-overlap" variant="Recoverable" route="Tier2" doc="Merge conflict / semantic overlap."
row "provider-unavailable" variant="Transient" retry="Backoff" doc="Provider unavailable."
row "controller-pi-restart" variant="Transient" retry="AfterRestart" doc="Controller / Pi restart."
row "stale-superseded-result" variant="Recoverable" route="Tier1" doc="Stale superseded result."
row "repair-budget-exhausted" variant="Paused" needs="ChooseAfterExhaustion" doc="Repair budget exhausted."
row "semantic-recovery-exhausted" variant="Paused" needs="ChooseAfterExhaustion" doc="The unchanged independent gate rejected the one admitted semantic recovery attempt; preserve both attempts and require operator disposition."
row "semantic-recovery-inadmissible" variant="Paused" needs="ReissueDecision" doc="Recovery lacks a complete typed diagnosis or cannot establish one admissible repair target; preserve evidence and require a new decision."
row "semantic-recovery-new-authority" variant="Paused" needs="ReissueDecision" doc="The correct repair exceeds original authority; require explicit replacement authority rather than widening scope."
row "semantic-recovery-infrastructure" variant="Paused" needs="SupplyCapability" doc="Recovery identified a provider/runtime/tooling boundary; repair capability outside the semantic loop."
row "semantic-recovery-unsafe" variant="Unsafe" boundary="EvidenceThreateningMutation" doc="Recovery found unsafe residue or an unsafe operation; halt the exact recovery boundary without retry."
row "sparse-materialization-path-escape" variant="Unsafe" boundary="OutOfScopeWrite" doc="Sparse materialization failure (path escape)."
row "sparse-materialization-disk-io" variant="Transient" retry="Backoff" doc="Sparse materialization failure (disk/IO)."

boundary "out-of-worktree-operator-checkout-writes" kind="OutOfScopeWrite" variant="Unsafe" doc="Out-of-worktree/operator-checkout writes."
boundary "agent-git-mutation" kind="AgentVersionMutation" variant="Unsafe" doc="Agent Git mutation."
boundary "fetch-push-remote-destructive-network-commands" kind="RemoteOrDestructiveNetwork" variant="Unsafe" doc="Fetch/push/remote/destructive network commands."
boundary "secret-private-key-access" kind="SecretMaterialAccess" variant="Unsafe" doc="Secret/private-key access."
boundary "unissued-bg-run" kind="UnissuedBackgroundLaunch" variant="Unsafe" doc="Unissued bg_run."
boundary "paid-metered-frontier-routing" kind="MeteredFrontierRoute" variant="Unsafe" doc="Paid/metered frontier routing."
boundary "unsafe-cleanup" kind="UnsafeCleanup" variant="Unsafe" doc="Unsafe cleanup."
boundary "corrupt-state-git-mutation-evidence-lost" kind="EvidenceThreateningMutation" variant="Unsafe" doc="Corrupt state/Git mutation where evidence could be lost."
